+                        // NCONR3decomp: MWCC sometimes folds identical case-handler
+                        // code across similarly-shaped switch functions, so `block`
+                        // can land inside an already-known *different* function's
+                        // range instead of being a genuine new function. Attribute
+                        // the reference to that function's start instead of
+                        // registering a duplicate/overlapping function at `block`.
+                        let resolved = self
+                            .functions
+                            .range(..=block)
